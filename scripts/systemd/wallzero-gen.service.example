# WallZero self-play generation loop, supervised: restarts if it ever dies
# and starts automatically after boot (after OC prep). Stopping the service
# kills the whole cgroup, so no orphaned chunk workers survive a stop.
[Unit]
Description=WallZero self-play generation loop
After=wallzero-prep.service
Wants=wallzero-prep.service

[Service]
User=@NODE_USER@
Environment=HOME=@NODE_HOME@
WorkingDirectory=@NODE_HOME@/wallzero
ExecStart=/bin/bash @NODE_HOME@/wallzero/gen_loop.sh
Restart=always
RestartSec=30
StandardOutput=append:@NODE_HOME@/wallzero/gen.log
StandardError=append:@NODE_HOME@/wallzero/gen.log

[Install]
WantedBy=multi-user.target
