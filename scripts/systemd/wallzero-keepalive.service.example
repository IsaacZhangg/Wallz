# Latch prevention: tiny always-on CUDA kernel so the GPU never leaves the
# P2 compute state (the driver-580 clock latch triggers on the idle
# P-state excursion between training and generation jobs). See
# scripts/node_gpu_keepalive.py for the rationale and measurements.
[Unit]
Description=WallZero GPU P2 keep-alive (clock-latch prevention)
After=wallzero-prep.service
Wants=wallzero-prep.service

[Service]
User=@NODE_USER@
Environment=HOME=@NODE_HOME@
WorkingDirectory=@NODE_HOME@/wallzero
ExecStart=@NODE_HOME@/wallzero/.venv/bin/python @NODE_HOME@/wallzero/gpu_keepalive.py
Restart=always
RestartSec=30
Nice=10
StandardOutput=append:@NODE_HOME@/wallzero/keepalive.log
StandardError=append:@NODE_HOME@/wallzero/keepalive.log

[Install]
WantedBy=multi-user.target
