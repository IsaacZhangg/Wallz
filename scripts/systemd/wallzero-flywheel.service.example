# WallZero auto-flywheel (train one round per 4 new shards), supervised:
# restarts if it ever dies and starts automatically after boot.
[Unit]
Description=WallZero auto-flywheel training loop
After=wallzero-prep.service
Wants=wallzero-prep.service

[Service]
User=@NODE_USER@
Environment=HOME=@NODE_HOME@
WorkingDirectory=@NODE_HOME@/wallzero
ExecStart=/bin/bash @NODE_HOME@/wallzero/flywheel.sh
Restart=always
RestartSec=30
StandardOutput=append:@NODE_HOME@/wallzero/flywheel.log
StandardError=append:@NODE_HOME@/wallzero/flywheel.log

[Install]
WantedBy=multi-user.target
