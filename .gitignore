.DS_Store
.firecrawl/
.pytest_cache/
.ruff_cache/
.ty/
.venv/
__pycache__/
*.py[cod]
artifacts/checkpoints/
artifacts/colab/
artifacts/replay/
# Shard copies pulled for offline measurement, and the Mac generator's
# working mirror. The measurements themselves (artifacts/ab) are evidence
# and stay tracked.
artifacts/eval-shards/
artifacts/holdout/
artifacts/mac-gen/
dist/

# Campaign artifacts: commit the evidence record (manifests, evaluation
# results, shipping checkpoints); keep multi-GB bundles and the transient
# local campaign mirror out of git. Bundle sha256s live in
# artifacts/runs/a100-bootstrap/campaign-manifest.json.
artifacts/runs/*
!artifacts/runs/a100-bootstrap/
artifacts/runs/a100-bootstrap/*
!artifacts/runs/a100-bootstrap/*.json
!artifacts/runs/a100-bootstrap/*.jsonl
!artifacts/runs/a100-bootstrap/*.pt

# Accidental root-level staging (resume bundles are built in the scratchpad)
/wallzero-output/

# Over GitHub 100MB limit; sha256 recorded in campaign-manifest.json
artifacts/runs/a100-bootstrap/best-r31-kata.pt
